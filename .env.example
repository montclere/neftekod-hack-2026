# Образец. `make setup` скопирует его в .env — останется вписать ключи.
# Сам .env в git не попадает.

# ─── Бэкенд ───
LLM_API_KEY=
LLM_BASE_URL=

# ─── Фронтенд ───
# ВАЖНО: Next.js читает только frontend/.env*, корневой .env он НЕ видит.
# `make setup` создаёт frontend/.env.local с этой строкой. Меняете здесь —
# поменяйте и там (или удалите frontend/.env.local и прогоните make setup).
NEXT_PUBLIC_API_URL=http://localhost:8000
